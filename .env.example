# Normally no environment credentials are needed: run python panbank.py --setup once.
# Optional environment overrides for systemd/containers:
# PANBANK_PASSWORD=...
# PANBANK_SESSION_SECRET=...
PANBANK_HOST=127.0.0.1
PANBANK_PORT=8765
# PANBANK_HOME=/home/panbank/PanBankWeb
# PANBANK_HTTPS=1
# PANBANK_ALLOWED_HOSTS=panbank.example.invalid
